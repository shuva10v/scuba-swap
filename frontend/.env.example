# ─────────────────────────────────────────────────────────────────────────────
# EVERY VITE_ VARIABLE IS COMPILED INTO THE PUBLIC BUNDLE.
# Treat this file as if it were served to the browser, because it effectively is.
# NEVER put RP_SIGNING_KEY here — that key is the app's identity and belongs in
# Secrets Manager, read only by the Lambda. See backend/README.md.
# ─────────────────────────────────────────────────────────────────────────────

# World ID app id from https://developer.world.org — starts with `app_`.
#
# This is NOT the rp_id. Both come from the same Developer Portal app:
#   app_id  → identifies the app to World App (public, goes in the client)
#   rp_id   → identifies the relying party when verifying (rp_d8319d06a1241d73)
#
# It must belong to the app that owns rp_d8319d06a1241d73, since that is the
# rp_id the router was deployed with and the backend signs for.
#
# It must also match the environment. The demo router points at the STAGING
# verifier (0x703a6316…), so the app requests staging proofs — staging and
# production are separate identity trees and a mismatch reverts
# InvalidMerkleRoot(). The app id needs to be the one valid for staging.
VITE_WORLD_APP_ID=app_

# Local demo chain. Defaults to http://127.0.0.1:8545 if unset.
# VITE_RPC_URL=http://127.0.0.1:8545

# ── Diagnostics for "Verification unavailable" ───────────────────────────────
# environment normally derives from the router's verifier (staging here). Set
# this only to test whether a staging/production mismatch is the cause.
# VITE_WORLD_ENV=production
#
# require_user_presence defaults on. Set false to test whether the app is
# configured for presence checks.
# VITE_REQUIRE_PRESENCE=false
