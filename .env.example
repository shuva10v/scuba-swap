# Ethereum mainnet fork (canonical Aqua). Any archive-capable endpoint.
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# World Chain fork (World ID 4.0 verifier + self-deployed Aqua).
# The invariant suite makes a lot of calls; public endpoints will HTTP 429 you.
# Verified working, in rough order of tolerance:
#   https://worldchain.drpc.org
#   https://worldchain-mainnet.gateway.tenderly.co
#   https://480.rpc.thirdweb.com
#   https://worldchain-mainnet.g.alchemy.com/public   (throttles quickly)
# Use your own key for anything sustained.
WORLDCHAIN_RPC_URL=https://worldchain.drpc.org
