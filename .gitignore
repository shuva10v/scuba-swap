node_modules/
out/
cache/
broadcast/
.env
.DS_Store

# World ID production proofs must never be committed. A production `nullifier`
# is a persistent pseudonymous identifier tied to a real Orb-verified identity:
# stable per (identity, rp_id, action), so publishing one lets anyone link that
# person's future verifications. Staging fixtures are fine.
*.PRIVATE.json
*production*.json
test/fixtures/**/production/

# Demo chain state — regenerate with script/demo-up.sh
deployments/demo.json
infra/cdk.out/

# CDK context cache: embeds the AWS account id and hosted zone id in its lookup
# keys. Not credentials, but no reason to publish them. Regenerated on synth
# (needs AWS credentials, since it re-queries Route53).
infra/cdk.context.json
